# ─── Suspicious Process Monitor — Environment Variables ───────────────────────
# Copy this file to .env and fill in your SMTP credentials.
# The application reads these values at startup via os.environ.
#
# For Gmail: use an "App Password" (not your real password).
#   1. Enable 2FA on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate an App Password for "Mail"
#   4. Paste it below as EMAIL_PASSWORD

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here

# Comma-separated list of recipients
EMAIL_RECIPIENTS=admin@example.com,security@example.com

# Set to true to enable email alerts (disabled by default)
EMAIL_ALERTS_ENABLED=false
